rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & RBAC EVALUATORS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isCitizen() {
      return hasRole('citizen') || hasRole('farmer');
    }

    function isFieldOfficer() {
      return hasRole('field_officer') || hasRole('meteorologist');
    }

    function isAuthorityAdmin() {
      return hasRole('authority_admin') || hasRole('imd_admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAuthorityAdmin();
      allow delete: if isAuthorityAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAuthorityAdmin();
      }
    }

    // ==========================================
    // WEATHERGPT CONVERSATIONS & CHAT HISTORY
    // ==========================================
    match /weathergpt_conversations/{conversationId} {
      allow read, write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ==========================================
    // IMD EARLY WARNINGS & CAP BULLETINS
    // ==========================================
    match /early_warnings/{warningId} {
      allow read: if true; // Public safety broadcast open to all citizens
      allow write: if isAuthorityAdmin() || isFieldOfficer();
    }

    // ==========================================
    // SYNOPTIC STATIONS & DOPPLER TELEMETRY
    // ==========================================
    match /synoptic_stations/{stationId} {
      allow read: if true;
      allow write: if isAuthorityAdmin();

      match /telemetry_history/{telemetryId} {
        allow read: if true;
        allow create: if isAuthorityAdmin();
      }
    }

    // ==========================================
    // SECTOR ADVISORIES (AGROMET, MARINE, AVIATION)
    // ==========================================
    match /sector_advisories/{advisoryId} {
      allow read: if true;
      allow write: if isAuthorityAdmin() || isFieldOfficer();
    }

    // ==========================================
    // CLIMATE TRENDS & DECADAL ANOMALIES
    // ==========================================
    match /climate_trends/{districtId} {
      allow read: if true;
      allow write: if isAuthorityAdmin();
    }

    // ==========================================
    // CITIZEN WEATHER & GROUND DAMAGE REPORTS
    // ==========================================
    match /incident_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.reportedByUserId == request.auth.uid;
      allow update: if isAuthorityAdmin() 
        || (isFieldOfficer() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verifiedBy', 'resolvedAt', 'resolutionNotes']))
        || (isOwner(resource.data.reportedByUserId) && resource.data.status == 'PENDING');
      allow delete: if isAuthorityAdmin();

      match /audit_trail/{auditId} {
        allow read: if isSignedIn();
        allow create: if isFieldOfficer() || isAuthorityAdmin();
      }
    }

    // ==========================================
    // EVACUATION SHELTERS & RELIEF CENTERS
    // ==========================================
    match /evacuation_shelters/{shelterId} {
      allow read: if true;
      allow write: if isAuthorityAdmin();
    }

    // ==========================================
    // ROAD STATUS & CORRIDORS
    // ==========================================
    match /road_status/{roadId} {
      allow read: if true;
      allow write: if isFieldOfficer() || isAuthorityAdmin();
    }

    // ==========================================
    // SYSTEM AUDIT LOGS
    // ==========================================
    match /system_audit_logs/{logId} {
      allow read: if isAuthorityAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
