rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & RBAC EVALUATORS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isCitizen() {
      return hasRole('citizen');
    }

    function isFieldOfficer() {
      return hasRole('field_officer');
    }

    function isAuthorityAdmin() {
      return hasRole('authority_admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAuthorityAdmin();
      allow delete: if isAuthorityAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAuthorityAdmin();
      }
    }

    // ==========================================
    // INCIDENT REPORTS COLLECTION
    // ==========================================
    match /incident_reports/{reportId} {
      // Any authenticated user or citizen can read incident reports
      allow read: if isSignedIn();

      // Any authenticated citizen/officer can submit new reports
      allow create: if isSignedIn() 
        && request.resource.data.reportedByUserId == request.auth.uid
        && request.resource.data.keys().hasAll(['category', 'severity', 'state', 'district', 'latitude', 'longitude', 'reportedAt']);

      // Field officers can verify/update status and add investigation notes
      // Citizens can update their own pending report before investigation begins
      allow update: if isAuthorityAdmin() 
        || (isFieldOfficer() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verifiedBy', 'resolvedAt', 'resolutionNotes']))
        || (isOwner(resource.data.reportedByUserId) && resource.data.status == 'PENDING');

      // Only authority admins can delete reports
      allow delete: if isAuthorityAdmin();

      // Sub-collection for audit trail
      match /audit_trail/{auditId} {
        allow read: if isSignedIn();
        allow create: if isFieldOfficer() || isAuthorityAdmin();
      }
    }

    // ==========================================
    // RISK ASSESSMENTS & PREDICTIONS
    // ==========================================
    match /risk_assessments/{districtId} {
      // Public / all authenticated users can read real-time risk predictions
      allow read: if isSignedIn();
      // Only ML backend service / authority admins can publish risk updates
      allow write: if isAuthorityAdmin();
    }

    // ==========================================
    // EARLY WARNINGS & ADVISORIES
    // ==========================================
    match /early_warnings/{warningId} {
      allow read: if true; // Public safety broadcasts
      allow write: if isAuthorityAdmin() || isFieldOfficer();
    }

    // ==========================================
    // IOT SENSORS & TELEMETRY
    // ==========================================
    match /iot_sensors/{sensorId} {
      allow read: if isSignedIn();
      allow write: if isAuthorityAdmin();

      match /telemetry_history/{telemetryId} {
        allow read: if isSignedIn();
        allow create: if isAuthorityAdmin();
      }
    }

    // ==========================================
    // ROAD STATUS & BLOCKAGES
    // ==========================================
    match /road_status/{roadId} {
      allow read: if true;
      allow write: if isFieldOfficer() || isAuthorityAdmin();
    }

    // ==========================================
    // SYSTEM AUDIT LOGS
    // ==========================================
    match /system_audit_logs/{logId} {
      allow read: if isAuthorityAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
